#!/usr/bin/env python3
"""Show missing dependencies and offer supervised APT installation."""
import argparse,subprocess,sys
GROUPS={
 'base':['git','python3','python3-venv','cmake','ninja-build'],
 'desktop':['xdotool','scrot','python3-pyatspi','at-spi2-core'],
 'android':['adb','apktool','default-jdk','gradle'],
 'windows':['mingw-w64','wine','cmake'],
 'reverse':['apktool','binutils','gdb','file']}
def missing_packages(group, check):
 return [pkg for pkg in GROUPS[group] if not check(pkg)]
def installed(pkg):
 r=subprocess.run(['dpkg-query','-W','-f=${Status}',pkg],capture_output=True,text=True)
 return r.returncode==0 and r.stdout.strip()=='install ok installed'
def main(argv=None):
 p=argparse.ArgumentParser();p.add_argument('group',choices=GROUPS);p.add_argument('--install',action='store_true')
 a=p.parse_args(argv);missing=missing_packages(a.group,installed)
 print('Grupo:',a.group,'\nPendientes:',', '.join(missing) if missing else 'ninguno')
 if not a.install or not missing:return 0
 print('Se instalarán paquetes de repositorios APT configurados en el sistema.')
 if input('Escribe INSTALAR para autorizar: ').strip()!='INSTALAR':return 1
 return subprocess.run(['sudo','apt-get','install','--',*missing],check=False).returncode
if __name__=='__main__':sys.exit(main())
