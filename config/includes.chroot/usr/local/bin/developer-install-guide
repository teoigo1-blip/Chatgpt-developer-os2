#!/usr/bin/env python3
"""Shows official package manager options; never runs downloaded scripts."""
import argparse, shutil, subprocess
GROUPS = {
 'build': ['live-build','debootstrap','xorriso','squashfs-tools'],
 'reverse': ['apktool','binutils','gdb','file'],
 'android': ['adb','apktool','default-jdk','gradle'],
 'windows': ['mingw-w64','wine','cmake','ninja-build'],
 'desktop': ['xdotool','scrot','python3-pyatspi'],
}
p=argparse.ArgumentParser(); p.add_argument('group',choices=GROUPS); p.add_argument('--install',action='store_true'); a=p.parse_args()
missing=[]
for package in GROUPS[a.group]:
 r=subprocess.run(['dpkg-query','-W','-f=${Status}',package],capture_output=True,text=True)
 if r.stdout.strip() != 'install ok installed': missing.append(package)
print('Pendientes:', ', '.join(missing) or 'ninguno')
if a.install and missing:
 print('Se instalarán únicamente paquetes del repositorio APT configurado.')
 if input('Escribe INSTALAR para continuar: ').strip()!='INSTALAR': raise SystemExit('Cancelado')
 subprocess.run(['sudo','apt-get','update'],check=True)
 subprocess.run(['sudo','apt-get','install','-y',*missing],check=True)
