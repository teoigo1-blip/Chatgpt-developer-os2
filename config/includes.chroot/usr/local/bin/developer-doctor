#!/usr/bin/env python3
"""Check essential local developer tools without changing the system."""
import shutil
import sys
tools = ("python3", "git", "node", "npm", "java", "cmake", "ninja")
missing = [name for name in tools if shutil.which(name) is None]
for name in tools:
    print(f"{name}: {'MISSING' if name in missing else 'OK'}")
sys.exit(bool(missing))
