#!/usr/bin/env python3
"""Report actual installed tools and Android SDK readiness."""
import argparse,json,os,shutil,sys,tomllib
from pathlib import Path

def inspect():
    commands=('git','python3','node','npm','java','javac','gradle','adb','fastboot','apktool','sdkmanager','aapt2','d8','apksigner','zipalign','cmake','ninja','gcc','clang','ld.lld','x86_64-w64-mingw32-gcc','wine','gdb','codex','rea','jadx','jadx-gui','ghidra','ghidra-headless','xdotool','scrot','chromium','code','uv','ruff','pytest','playwright','playwright-mcp','shellcheck','scrcpy','podman','restic','ccache','cryptsetup','jq','sqlite3')
    tools={name:shutil.which(name) for name in commands}
    sdk=Path(os.environ.get('ANDROID_HOME','/opt/android-sdk'))
    android={'root':str(sdk),'platform_36':(sdk/'platforms/android-36/android.jar').is_file(),'build_tools_36':(sdk/'build-tools/36.0.0/aapt2').is_file(),'license':(sdk/'licenses/android-sdk-license').is_file()}
    ready=all(tools.values()) and all(android[k] for k in ('platform_36','build_tools_36','license'))
    config=Path.home()/'.codex/config.toml'
    try: registered='rea' in tomllib.loads(config.read_text()).get('mcp_servers',{})
    except (OSError,tomllib.TOMLDecodeError): registered=False
    rea={'ghidra':Path('/opt/developer-os/ghidra_12.1.4_PUBLIC/support/analyzeHeadless').is_file(),'android_engine':Path('/opt/developer-os/rea-jadx/jadx-headless-mcp-0.7.1-all.jar').is_file(),'codex_registration':registered}
    return {'ready':ready and all(rea.values()),'tools':tools,'android':android,'rea':rea,'account_login':'Inicia sesión con developer-codex login; las credenciales no se incluyen en la ISO.'}

def main():
    p=argparse.ArgumentParser();p.add_argument('--json',action='store_true');p.add_argument('--strict',action='store_true');args=p.parse_args()
    report=inspect()
    if args.json: print(json.dumps(report,ensure_ascii=False,indent=2))
    else:
        for name,path in report['tools'].items(): print(('[OK] ' if path else '[FALTA] ')+name+((': '+path) if path else ''))
        print('\nAndroid SDK:',report['android']['root'])
        for key in ('platform_36','build_tools_36','license'): print(('[OK] ' if report['android'][key] else '[FALTA] ')+key)
        for key,value in report['rea'].items(): print(('[OK] REA ' if value else '[FALTA] REA ')+key)
        print('\n'+report['account_login'])
    return 1 if args.strict and not report['ready'] else 0

if __name__=='__main__':sys.exit(main())
