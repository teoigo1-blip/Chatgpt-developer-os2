#!/usr/bin/env python3
"""Supervised browser automation with Playwright; no credential extraction."""
import argparse
import sys
from urllib.parse import urlparse

def main():
    parser = argparse.ArgumentParser(description="Supervised browser navigation")
    parser.add_argument("url")
    parser.add_argument("--headed", action="store_true", help="Display browser for user supervision")
    args = parser.parse_args()
    parsed = urlparse(args.url)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        parser.error("A valid HTTPS URL without embedded credentials is required")
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        parser.error("Playwright is optional; install it in a user virtual environment first")
    with sync_playwright() as playwright:
        browser = playwright.chromium.launch(headless=not args.headed)
        page = browser.new_page()
        page.goto(args.url, wait_until="domcontentloaded", timeout=30000)
        print("Title:", page.title())
        print("URL:", page.url)
        if args.headed:
            input("Review the browser, then press Enter to close it...")
        browser.close()
    return 0

if __name__ == "__main__":
    sys.exit(main())
