#!/usr/bin/env python3
"""APT tool groups with explicit confirmation; no silent installs."""
import argparse, subprocess, shutil
GROUPS={'base':['git','python3','python3-venv','cmake','ninja-build'], 'desktop':['xdotool','scrot','python3-pyatspi','at-spi2-core'], 'android':['adb','apktool','default-jdk','gradle'], 'windows':['mingw-w64','wine','cmake']}
p=argparse.ArgumentParser(); p.add_argument('group',choices=GROUPS); p.add_argument('--install',action='store_true'); a=p.parse_args()
missing=[x for x in GROUPS[a.group] if subprocess.run(['dpkg-query','-W','-f=${Status}',x],capture_output=True,text=True).stdout.strip()!='install ok installed']
print('Grupo:',a.group,'; faltan:',', '.join(missing) or 'ninguna')
if a.install and missing:
    if input('¿Instalar mediante apt? Escribe INSTALAR: ').strip()!='INSTALAR': raise SystemExit('Cancelado')
    subprocess.run(['sudo','apt-get','install','-y',*missing],check=True)
