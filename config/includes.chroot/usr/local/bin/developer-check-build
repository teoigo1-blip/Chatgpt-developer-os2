#!/usr/bin/env python3
import shutil
import os

items = {'Codex CLI':'codex', 'Android Studio':'studio', 'Java':'java', 'Gradle':'gradle', 'ADB':'adb', 'CMake':'cmake', 'MinGW-w64':'x86_64-w64-mingw32-gcc', 'Wine':'wine', 'Ghidra':'ghidraRun', 'JADX':'jadx', 'Apktool':'apktool', 'REA':'rea'}
for name, command in items.items():
    found = shutil.which(command)
    if name == 'Android Studio' and not found:
        for path in ('/opt/android-studio/bin/studio.sh', '/opt/android-studio/bin/studio'):
            if os.path.exists(path): found = path; break
    print(f'{name}: {found or "NO INSTALADO"}')
print('ANDROID_HOME:', os.environ.get('ANDROID_HOME', 'SIN CONFIGURAR'))
