#!/usr/bin/env python3
"""Copy examples once; never overwrite a user's edited project."""
import argparse,shutil
from pathlib import Path
p=argparse.ArgumentParser();p.add_argument('--destination',type=Path,default=Path.home()/'Projects/Ejemplos');a=p.parse_args()
source=Path('/usr/local/share/developer-os/examples');a.destination.mkdir(parents=True,exist_ok=True)
for item in source.iterdir():
    dest=a.destination/item.name
    if dest.exists():print('Conservado:',dest);continue
    if item.is_dir():shutil.copytree(item,dest)
    else:shutil.copy2(item,dest)
    print('Creado:',dest)
