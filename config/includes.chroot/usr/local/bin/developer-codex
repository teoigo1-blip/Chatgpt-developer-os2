#!/usr/bin/env python3
"""Puente supervisado con Codex CLI oficial instalado por el usuario."""
import argparse, os, shutil, subprocess, sys
from pathlib import Path
def main():
    p=argparse.ArgumentParser(description='Codex CLI: autenticación y ejecución supervisada')
    sub=p.add_subparsers(dest='action',required=True)
    sub.add_parser('status'); sub.add_parser('login')
    run=sub.add_parser('run'); run.add_argument('project'); run.add_argument('prompt'); run.add_argument('--confirm',action='store_true')
    a=p.parse_args()
    codex=shutil.which('codex')
    if not codex: raise SystemExit('Codex CLI no instalado. Instálalo desde la documentación oficial de OpenAI.')
    if a.action=='status': return subprocess.run([codex,'login','status'],check=False).returncode
    if a.action=='login': return subprocess.run([codex,'login'],check=False).returncode
    if not a.confirm: raise SystemExit('Se requiere --confirm para ejecutar una tarea que pueda modificar archivos')
    if (Path.home()/'.local/share/developer-os/STOP').exists(): raise SystemExit('Agente detenido')
    project=Path(a.project).expanduser().resolve()
    if not project.is_dir(): raise SystemExit('La carpeta del proyecto no existe')
    if len(a.prompt)>12000: raise SystemExit('Instrucción demasiado larga')
    # Sin --dangerously-bypass-approvals-and-sandbox; mantener las protecciones oficiales.
    return subprocess.run([codex,'exec','--cd',str(project),a.prompt],check=False).returncode
if __name__=='__main__': sys.exit(main())
