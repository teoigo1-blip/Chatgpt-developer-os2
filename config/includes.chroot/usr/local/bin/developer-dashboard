#!/usr/bin/env python3
"""Spanish desktop entry points; every interactive operation stays visible."""
import argparse,subprocess,tkinter as tk
from tkinter import ttk,filedialog,messagebox,scrolledtext
from pathlib import Path
import shutil,threading

class Dashboard:
    def __init__(self,root):
        self.root=root;root.title('ChatGPT Developer OS — Tu espacio de trabajo');root.geometry('980x700');root.minsize(820,600)
        ttk.Label(root,text='ChatGPT Developer OS',font=('Sans',23,'bold')).pack(anchor='w',padx=24,pady=(22,3))
        ttk.Label(root,text='Codex · REA · desarrollo y recuperación',font=('Sans',12)).pack(anchor='w',padx=26,pady=(0,16))
        tabs=ttk.Notebook(root);tabs.pack(fill='both',expand=True,padx=20,pady=10)
        for title,items in [
          ('Empezar', [('Iniciar sesión en Codex',['developer-codex','login']),('Abrir Codex',['codex']),('Abrir editor',['code',str(Path.home()/'Projects')]),('Comprobar herramientas',['developer-doctor','--strict']),('Comprobar REA',['rea','doctor','--provider','ghidra']),('Mostrar Android conectado',['scrcpy'])]),
          ('Proyectos y pruebas',[('Crear ejemplos',['developer-demos']),('Abrir proyectos',['thunar',str(Path.home()/'Projects')]),('Probar herramientas nuevas',['developer-enhancement-test']),('Probar contenedor sin red',['developer-container-test']),('Abrir terminal',['xfce4-terminal']),('Panel avanzado',['developer-panel'])]),
          ('Copias y USB',[('Configurar copia cifrada',['developer-backup','init']),('Crear copia',['developer-backup','create']),('Ver copias',['developer-backup','list']),('Comprobar copia',['developer-backup','check']),('Recuperar en carpeta nueva',['developer-backup','restore']),('Preparar persistencia USB cifrada',['sudo','developer-usb-persistence']),('Abrir Discos',['gnome-disks'])]),
          ('Ayuda',[('Guía sin conexión',['xdg-open','/usr/local/share/developer-os/guia.html']),('Ver estado de Codex',['developer-codex','status']),('Documentación de REA',['rea','--help']),('Estadísticas de caché',['ccache','--show-stats'])])]:
            frame=ttk.Frame(tabs,padding=22);tabs.add(frame,text=title)
            for i,(label,cmd) in enumerate(items):
                ttk.Button(frame,text=label,command=lambda c=cmd:self.launch(c)).grid(row=i//2,column=i%2,sticky='nsew',padx=9,pady=10,ipady=16)
            for col in range(2):frame.columnconfigure(col,weight=1)
        self.status=tk.StringVar(value='Los proyectos se conservan al apagar solo si has preparado la persistencia.');ttk.Label(root,textvariable=self.status,wraplength=920).pack(anchor='w',padx=24,pady=10)
        free=shutil.disk_usage(Path.home()).free//1024**2
        ttk.Label(root,text=f'Espacio libre en la sesión: {free} MiB · Guía y ejemplos disponibles sin Internet').pack(anchor='w',padx=24,pady=(0,18))
    def launch(self,cmd):
        if cmd==['developer-backup','init']:
            folder=filedialog.askdirectory(title='Elige una carpeta para guardar las copias cifradas')
            if not folder:return
            cmd=[*cmd,'--repo',folder]
        if cmd[0] in ('code','thunar','xdg-open','gnome-disks','xfce4-terminal','developer-panel'):
            subprocess.Popen(cmd);return
        import shlex
        # Visible terminal, shell-quoted argv; no user-provided text is evaluated.
        command=shlex.join(cmd)
        subprocess.Popen(['xfce4-terminal','--disable-server','--hold','--command',command])

if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--self-test',action='store_true');a=p.parse_args()
    root=tk.Tk();Dashboard(root)
    if a.self_test:root.after(1000,root.destroy)
    root.mainloop()
    if a.self_test:print('DASHBOARD_OK')
