#!/usr/bin/env python3
"""Controlled Android/Windows/Linux project builder (no shell interpolation)."""
import argparse
import pathlib
import shutil
import subprocess
import sys


def command_for(kind, root):
    if kind == 'android':
        wrapper = root / 'gradlew'
        if wrapper.is_file():
            return ['bash', str(wrapper), 'assembleDebug']
        if shutil.which('gradle'):
            return ['gradle', 'assembleDebug']
        raise RuntimeError('No se encontró Gradle ni gradlew')
    if kind in ('windows', 'linux'):
        if not (root / 'CMakeLists.txt').is_file():
            raise RuntimeError('Se necesita CMakeLists.txt')
        if not shutil.which('cmake'):
            raise RuntimeError('Falta CMake')
        args = ['cmake', '-S', str(root), '-B', str(root / 'build')]
        if kind == 'windows':
            if not shutil.which('x86_64-w64-mingw32-gcc'):
                raise RuntimeError('Falta MinGW-w64')
            args += ['-DCMAKE_SYSTEM_NAME=Windows', '-DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc', '-DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++']
        return args
    raise RuntimeError('Plataforma no admitida')


def main():
    p = argparse.ArgumentParser(description='Compilar proyectos con confirmación')
    p.add_argument('platform', choices=['android', 'windows', 'linux'])
    p.add_argument('project', type=pathlib.Path)
    p.add_argument('--yes', action='store_true', help='Autorizar ejecución')
    a = p.parse_args()
    root = a.project.expanduser().resolve(strict=True)
    if not root.is_dir():
        p.error('El proyecto debe ser una carpeta')
    try:
        cmd = command_for(a.platform, root)
    except RuntimeError as exc:
        p.error(str(exc))
    print('Proyecto:', root, '\nComando:', ' '.join(cmd), flush=True)
    if not a.yes:
        print('Vista previa. Añade --yes para ejecutar.')
        return 0
    with (root / 'developer-build.log').open('a', encoding='utf-8') as log:
        result = subprocess.run(cmd, cwd=root, stdout=log, stderr=subprocess.STDOUT, check=False)
        if result.returncode == 0 and a.platform in ('windows', 'linux'):
            result = subprocess.run(['cmake', '--build', str(root / 'build')], cwd=root, stdout=log, stderr=subprocess.STDOUT, check=False)
    print('Resultado:', result.returncode, 'Registro:', root / 'developer-build.log')
    return result.returncode

if __name__ == '__main__':
    sys.exit(main())
