#!/usr/bin/env python3
"""Supervised administration: allowlisted system maintenance via sudo."""
import argparse
import shutil
import subprocess
import sys

ALLOWED = {
    "update": ["apt-get", "update"],
    "upgrade": ["apt-get", "upgrade"],
    "wifi-status": ["nmcli", "device", "status"],
    "bluetooth-status": ["systemctl", "status", "bluetooth", "--no-pager"],
}

def main():
    parser = argparse.ArgumentParser(description="Run a supervised system administration task")
    parser.add_argument("action", choices=ALLOWED)
    parser.add_argument("--confirm", action="store_true", help="Confirm privileged changes")
    args = parser.parse_args()
    command = ALLOWED[args.action]
    if args.action in ("update", "upgrade"):
        if not args.confirm:
            parser.error("Privileged changes require --confirm")
        if not sys.stdin.isatty():
            parser.error("A terminal is required for sudo authentication")
        if not shutil.which("sudo"):
            parser.error("sudo not installed")
        command = ["sudo", "--", *command]
    print("Executing:", " ".join(command), flush=True)
    return subprocess.run(command, check=False).returncode

if __name__ == "__main__":
    raise SystemExit(main())
