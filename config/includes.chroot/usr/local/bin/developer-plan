#!/usr/bin/env python3
"""Validate and preview a declarative plan; never execute plan steps."""
import argparse
import json
from pathlib import Path

def main():
    parser = argparse.ArgumentParser(description="Preview a safe declarative development plan")
    parser.add_argument("file", type=Path)
    args = parser.parse_args()
    data = json.loads(args.file.read_text(encoding="utf-8"))
    if not isinstance(data, dict) or not isinstance(data.get("steps"), list):
        parser.error("Plan must contain a steps list")
    allowed = {"note", "inspect", "review"}
    for index, step in enumerate(data["steps"], 1):
        if not isinstance(step, dict) or step.get("action") not in allowed:
            parser.error(f"Step {index}: unsupported or unsafe action")
    print(json.dumps({"preview": data["steps"], "executed": False}, ensure_ascii=False, indent=2))

if __name__ == "__main__":
    main()
